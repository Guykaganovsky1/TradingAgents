# ============================================================
# TradingAgents Dashboard — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values you need.
# Secrets marked "auto-generated" are created on first run if
# left blank; they are then written to backend/data/.token and
# do NOT need to be set manually unless you want a fixed value.
# ============================================================

# ----------------------------------------------------------
# Backend (FastAPI on :8787)
# ----------------------------------------------------------

# Bearer token that the frontend sends with every API request.
# Auto-generated on first run and written to backend/data/.token.
# Leave blank to let init-first-run.sh create it, or set a
# fixed value for reproducible deployments (min 32 chars).
DASHBOARD_API_TOKEN=

# Fernet symmetric key used to encrypt stored LLM API keys.
# Auto-generated if blank. Keep this secret and consistent —
# changing it invalidates all previously encrypted secrets.
DASHBOARD_SECRET_KEY=

# Comma-separated origins that the backend CORS policy allows.
# Add your production frontend URL when deploying.
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host and port the uvicorn process binds to.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Path to the SQLite database file (relative to dashboard/).
DASHBOARD_DB_PATH=./backend/data/dashboard.db

# Logging level: DEBUG | INFO | WARNING | ERROR
DASHBOARD_LOG_LEVEL=INFO

# ----------------------------------------------------------
# TradingAgents engine
# ----------------------------------------------------------

# Path to the existing TradingAgents results directory
# (relative to dashboard/). The backend reads past analysis
# reports from here and writes new ones alongside them.
TRADINGAGENTS_RESULTS_DIR=../results

# ----------------------------------------------------------
# LLM provider API keys
# (optional — can also be set through the Settings UI at
#  runtime; storing them here overrides any UI-saved value)
# ----------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ----------------------------------------------------------
# Ollama (local model server)
# ----------------------------------------------------------

# Base URL of your Ollama server. Change the host/port if
# Ollama runs on a different machine or non-default port.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------
# Frontend (Next.js on :3000)
# ----------------------------------------------------------

# Internal URL the Next.js BFF proxy uses to reach the backend.
# This is server-side only — never exposed to the browser.
# In Docker, use http://backend:8787 (the service name).
BACKEND_URL=http://localhost:8787

# Display name shown in the browser tab and header.
NEXT_PUBLIC_APP_NAME=TradingAgents
